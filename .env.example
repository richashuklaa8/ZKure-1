# Required for the initial administrator account
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Required: generate a 32-byte key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RECORD_ENCRYPTION_KEY=

# Optional deployment configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Set to the persistent disk path on Render if using a paid persistent disk.
# DATABASE_PATH=/var/data/zkure.db
# CORS_ORIGINS=https://your-domain.example
# IPFS_API_URL=
# IPFS_API_TOKEN=
